{
  "name": "sefikh",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx --conditions=react-server prisma/seed.ts",
    "db:reset": "prisma migrate reset --force --skip-seed && npm run db:seed",
    "db:studio": "prisma studio",
    "stripe:listen": "stripe listen --forward-to localhost:3000/api/stripe/webhook",
    "setup": "npm install && prisma migrate deploy && npm run db:seed"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.8.1",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "lucide-react": "^1.61.0",
    "next": "16.4.3",
    "nodemailer": "^10.2.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "stripe": "^23.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "prisma": {
    "seed": "tsx --conditions=react-server prisma/seed.ts"
  },
  "engines": {
    "node": ">=20.9"
  },
  "overrides": {
    "sharp": "$sharp"
  }
}
