# ── Application ───────────────────────────────────────────────
APP_URL="http://localhost:3000"
# Secret utilisé pour signer les cookies visiteurs (32+ caractères aléatoires : `openssl rand -hex 32`)
AUTH_SECRET="change-me-with-openssl-rand-hex-32"

# ── Base de données ───────────────────────────────────────────
# Dev : SQLite. Prod : PostgreSQL (changer aussi `provider` dans prisma/schema.prisma)
DATABASE_URL="file:./dev.db"

# ── E-mails (SMTP) ────────────────────────────────────────────
# Sans SMTP_HOST, les e-mails sont journalisés en base et consultables sur /dev/mailbox (dev uniquement).
# Exemples : Resend (smtp.resend.com:465), Brevo, Mailtrap, OVH…
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM="SEFIKH <hello@sefikh.com>"
# Destinataire des messages du formulaire de contact
CONTACT_INBOX="hello@sefikh.com"

# ── Paiements (Stripe) ────────────────────────────────────────
# Clés de test : https://dashboard.stripe.com/test/apikeys
# Sans STRIPE_SECRET_KEY, un mode de paiement simulé est proposé (dev uniquement).
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ── Stockage des fichiers ─────────────────────────────────────
STORAGE_DIR="./storage"

# ── Recherche par image (CLIP local) ──────────────────────────
# "off" pour désactiver le modèle (repli sur l'empreinte couleur)
CLIP_MODE="on"
